// FSM transition checks for the UART receiver of this example (uart_rx): the legal next states, the conditions of
// the transitions, what valid / frame_err say about the state.
//   sva parse examples/fsm/uart_pkg.sv examples/fsm/fsm.sva      (the package first: it declares the state names)
module uart_rx_checks import uart_pkg::*; #(parameter int BIT = 4) (
  input logic       clk, rst_n, rxd, valid, frame_err,
  input logic [7:0] data,
  input state_t     state,
  input logic [2:0] bit_cnt
);
  localparam int FRAME = 10 * BIT;   // start, 8 data bits, stop

  default clocking @(posedge clk); endclocking
  default disable iff (!rst_n);

  // the legal next states
  fsm_from_idle:  assert property (state == IDLE  |=> state inside {IDLE, START});
  fsm_from_start: assert property (state == START |=> state inside {START, IDLE, DATA});
  fsm_from_data:  assert property (state == DATA  |=> state inside {DATA, STOP});
  fsm_from_stop:  assert property (state == STOP  |=> state inside {STOP, IDLE, ERROR});
  fsm_from_error: assert property (state == ERROR |=> state inside {ERROR, IDLE});
  // why the state changes
  fsm_start_bit:  assert property (state == IDLE && !rxd |=> state == START);
  fsm_error_exit: assert property (state == ERROR && rxd |=> state == IDLE);
  fsm_data_bits:  assert property (state == DATA |-> bit_cnt <= 7);
  fsm_frame_time: assert property ($rose(state == DATA) |-> ##[1:FRAME] state != DATA);
  // deliberately wrong (8 data bits take 8 * BIT cycles): shows a fail trace, sva eval exits 1
  fsm_demo_short_data: assert property ($rose(state == DATA) |-> ##[1:2*BIT] state != DATA);
  // the outputs
  fsm_valid:      assert property (valid |-> state == IDLE && $past(state) == STOP) else $error("valid outside the end of a frame");
  fsm_frame_err:  assert property (frame_err |-> state == ERROR);
  fsm_one_flag:   assert property (!(valid && frame_err));
  // coverage: a good byte, a framing error
  fsm_cov_byte:   cover property (state == START ##1 state == DATA [*1:$] ##1 state == STOP ##[1:$] valid);
  fsm_cov_error:  cover property (state == STOP ##[1:$] state == ERROR ##[1:$] state == IDLE);
endmodule

bind uart_rx uart_rx_checks #(.BIT(BIT)) u_checks (.*);

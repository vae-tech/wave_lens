/*
================================================================================
  apb.sva
  APB3 checks for the WaveLens APB example (apb_tb.sv).
================================================================================

    Description:
      One checker module, apb_checks, bound to apb_tb.  It checks
        - the APB3 protocol at the slave (apb_regs): SETUP is followed by
          ACCESS, the address, the direction and the write data hold until
          the end of the transfer, a wait state keeps ACCESS;
        - this slave: a read of a register takes two wait states, an
          unmapped address is answered with PSLVERR;
        - the master's phase FSM (apb_master, enum apb_pkg::phase_t);
        - one deliberate failure (apb_demo_no_wait) that shows a fail
          trace: sva eval exits 1;
        - covers of a write, a read with its wait states and an error.

    Parse:  sva parse examples/apb/apb_tb.sv examples/apb/apb.sva
            (the testbench first: it declares apb_pkg)
            make sva-examples (all three examples, parse and eval)
*/

// The two bus phases of APB3, as seen on PSEL / PENABLE.
`define SETUP  (PSEL && !PENABLE)
`define ACCESS (PSEL && PENABLE)

//==============================================================================
// apb_checks: bound to apb_tb, the ports connect by name (.*)
//==============================================================================

module apb_checks import apb_pkg::*; (
    input logic        PCLK,
    input logic        PRESETn,
    input logic        PSEL,
    input logic        PENABLE,
    input logic        PWRITE,
    input logic        PREADY,
    input logic        PSLVERR,
    input logic [7:0]  PADDR,
    input logic [31:0] PWDATA,
    input logic [31:0] PRDATA,
    input phase_t      phase
);
    default clocking @(posedge PCLK); endclocking
    default disable iff (!PRESETn);

    //==========================================================================
    // Protocol (AMBA APB3, IHI0024: Transfers, Operating states)
    //==========================================================================

    // Operating states: SETUP lasts one cycle and always moves to ACCESS.
    apb_setup_then_access: assert property (`SETUP |=> `ACCESS)
        else $error("APB: SETUP not followed by ACCESS");

    // Operating states: PENABLE is only asserted in ACCESS, which needs PSEL.
    apb_enable_needs_sel: assert property (PENABLE |-> PSEL)
        else $error("APB: PENABLE without PSEL");

    // Transfers with wait states: while PREADY is low the bus stays in ACCESS.
    apb_wait_holds: assert property (`ACCESS && !PREADY |=> `ACCESS);

    // Transfers: PADDR and PWRITE hold from SETUP until the last cycle of ACCESS.
    apb_addr_stable: assert property (
        PSEL && !(PENABLE && PREADY) |=>
            $stable(PADDR) && $stable(PWRITE)
    );

    // Write transfers: PWDATA holds from SETUP until the last cycle of ACCESS.
    apb_wdata_stable: assert property (
        PSEL && PWRITE && !(PENABLE && PREADY) |=>
            $stable(PWDATA)
    );

    // Operating states: PENABLE drops after the transfer (to IDLE or a new SETUP).
    apb_end_of_transfer: assert property (`ACCESS && PREADY |=> !PENABLE);

    //==========================================================================
    // This slave (apb_regs)
    //==========================================================================

    // A read of a mapped register takes two wait states, then PREADY.
    apb_read_waits: assert property (
        `SETUP && !PWRITE && PADDR[7:4] == 0 && PADDR[1:0] == 0 |=>
            !PREADY[*2] ##1 PREADY
    );

    // Error response: an unmapped address ends with PSLVERR (on the cycle of PREADY).
    apb_slverr_unmapped: assert property (
        `ACCESS && PREADY && PADDR[7:4] != 0 |->
            PSLVERR
    ) else $error("APB: unmapped %h without PSLVERR", PADDR);

    //==========================================================================
    // The master's phases (apb_master.phase)
    //==========================================================================

    // The FSM follows the protocol: SETUP for one cycle, then ACCESS.
    apb_phase_order: assert property (phase == SETUP |=> phase == ACCESS);

    // PSEL is decoded from the phase: high in every phase but IDLE.
    apb_phase_sel: assert property ((phase == IDLE) == !PSEL);

    //==========================================================================
    // Deliberate failure
    //==========================================================================

    // Deliberately wrong (the slave has read wait states): shows a fail trace,
    // sva eval exits 1.
    apb_demo_no_wait: assert property (`ACCESS |-> PREADY)
        else $error("demo: a wait state");

    //==========================================================================
    // Coverage
    //==========================================================================

    // A write without wait states: SETUP, then ACCESS with PREADY.
    apb_cov_write: cover property (`SETUP && PWRITE ##1 `ACCESS && PREADY);

    // A read with its two wait states.
    apb_cov_read_wait: cover property (
        `SETUP && !PWRITE ##1
        (`ACCESS && !PREADY)[*2] ##1
        PREADY
    );

    // An error response (the write to the unmapped address 0x40).
    apb_cov_error: cover property (`ACCESS && PREADY && PSLVERR);
endmodule

//==============================================================================
// Bind: every port of apb_checks is a signal of apb_tb
//==============================================================================

bind apb_tb apb_checks u_apb_checks (.*);

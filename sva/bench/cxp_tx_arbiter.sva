// Three checks of the CoaXPress TX arbiter of work/test_stream_video (the performance target of docs/sva/ENGINE.md):
//   sva eval --waves work/test_stream_video.fst --sva sva/bench/cxp_tx_arbiter.sva \
//     --scope tb_cxp_top.cxp_device_top_i.cxp_interface_top_i.cxp_tx_domain_i.cxp_tx_arbiter_i
module cxp_tx_arbiter_checks (input logic tx_clk, tx_rst_n, m_ready_i, input logic [2:0] ready_o);
  default clocking @(posedge tx_clk); endclocking
  default disable iff (!tx_rst_n);
  // one source at most is told it may send
  arb_one_ready: assert property ($onehot0(ready_o));
  // the output holds its word while the sink is not ready
  arb_hold:      assert property (m_o.valid && !m_ready_i |=> m_o.valid && $stable(m_o.data) && $stable(m_o.kmask));
  // a packet that starts ends (a strong eventually: every start waits for its end)
  arb_packet:    assert property (m_o.valid && m_o.sop && m_ready_i |-> s_eventually (m_o.valid && m_o.eop && m_ready_i));
endmodule

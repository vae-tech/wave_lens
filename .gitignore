# simulator dumps (large; regenerate or keep outside git), anywhere
*.vcd
*.fst
# pages built from your configs by make html (self-contained copies of wavefw.js + data)
work/*.html
examples/*/*.html
# build products with make BUILD=build (default BUILD is /tmp/wavefw)
build/
# Python caches
__pycache__/
*.pyc
# Rust (make sva-build puts its target under BUILD; these catch a plain cargo build) and wasm-pack output
target/
pkg/

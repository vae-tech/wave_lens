{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/vae-tech/wavelens/master/docs/sva/ast.schema.json",
  "title": "WaveLens SVA: a parsed file",
  "description": "The output of `sva parse --json` (an object {files: [Parsed + file]}) and of the WebAssembly call run_json({source}) (one Parsed). docs/sva/LANGUAGE.md has the language; sva/core/src/ast.rs the types. sva/core/tests/schema.rs checks every corpus file against this schema.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/parsed" },
    {
      "type": "object",
      "required": ["files"],
      "additionalProperties": false,
      "properties": { "files": { "type": "array", "items": { "$ref": "#/$defs/parsed_file" } } }
    }
  ],
  "$defs": {
    "span": {
      "description": "1-based line and column (characters), byte offsets start..end in the file.",
      "type": "object",
      "required": ["line", "col", "start", "end"],
      "additionalProperties": false,
      "properties": {
        "line": { "type": "integer", "minimum": 0 },
        "col": { "type": "integer", "minimum": 0 },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 }
      }
    },
    "error": {
      "description": "An error or a warning. found / expected: what the parser saw and wanted (syntax errors).",
      "type": "object",
      "required": ["line", "col", "start", "end", "msg"],
      "additionalProperties": false,
      "properties": {
        "line": { "type": "integer" },
        "col": { "type": "integer" },
        "start": { "type": "integer" },
        "end": { "type": "integer" },
        "msg": { "type": "string" },
        "found": { "type": "string" },
        "expected": { "type": "string" }
      }
    },
    "parsed": {
      "type": "object",
      "required": ["assertions", "sequences", "properties", "scopes", "binds", "errors", "warnings"],
      "additionalProperties": false,
      "properties": {
        "assertions": { "type": "array", "items": { "$ref": "#/$defs/assertion" } },
        "sequences": { "type": "array", "items": { "$ref": "#/$defs/seq_decl" } },
        "properties": { "type": "array", "items": { "$ref": "#/$defs/prop_decl" } },
        "scopes": { "type": "array", "items": { "$ref": "#/$defs/scope" } },
        "binds": { "type": "array", "items": { "$ref": "#/$defs/bind" } },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/error" } },
        "warnings": { "type": "array", "items": { "$ref": "#/$defs/error" } }
      }
    },
    "parsed_file": {
      "description": "A Parsed with the file name (sva parse --json).",
      "type": "object",
      "required": ["file", "assertions", "sequences", "properties", "scopes", "binds", "errors", "warnings"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string" },
        "assertions": { "type": "array", "items": { "$ref": "#/$defs/assertion" } },
        "sequences": { "type": "array", "items": { "$ref": "#/$defs/seq_decl" } },
        "properties": { "type": "array", "items": { "$ref": "#/$defs/prop_decl" } },
        "scopes": { "type": "array", "items": { "$ref": "#/$defs/scope" } },
        "binds": { "type": "array", "items": { "$ref": "#/$defs/bind" } },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/error" } },
        "warnings": { "type": "array", "items": { "$ref": "#/$defs/error" } }
      }
    },
    "assertion": {
      "description": "An expanded assertion: instances carry their bodies, constants their values, bounds are numbers, every sequence element (a boolean that can match at a tick) has an id s1, s2, ... listed in elements.",
      "type": "object",
      "required": ["label", "kind", "clock", "prop", "text", "elements", "signals", "line", "at"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "description": "The statement label, or assert_<line> / assume_<line> / cover_<line>." },
        "kind": { "enum": ["assert", "assume", "cover"] },
        "scope": { "type": "string", "description": "The module, interface, program or checker it is written in." },
        "property": { "type": "string", "description": "The property or sequence name when the assertion is one instance." },
        "clock": { "$ref": "#/$defs/clock" },
        "disable": { "$ref": "#/$defs/expr" },
        "prop": { "$ref": "#/$defs/prop" },
        "text": { "type": "string", "description": "The property on one line (instances replaced by their bodies), as reports and the page show it." },
        "elements": { "type": "array", "items": { "$ref": "#/$defs/element" } },
        "signals": { "type": "array", "items": { "$ref": "#/$defs/signal" }, "description": "Every signal read, the clock first." },
        "message": { "type": "string" },
        "severity": { "enum": ["error", "fatal", "warning", "info"] },
        "flags": { "type": "array", "items": { "type": "string" } },
        "line": { "type": "integer" },
        "at": { "$ref": "#/$defs/span" }
      }
    },
    "clock": {
      "type": "object",
      "required": ["edge", "signal"],
      "additionalProperties": false,
      "properties": { "edge": { "enum": ["posedge", "negedge", "edge"] }, "signal": { "type": "string" } }
    },
    "element": {
      "description": "A step the viewer draws: the id of a bool node of prop, its label (the delay or repetition around it included: ##[1:3] ack, b[->2]).",
      "type": "object",
      "required": ["id", "label", "at"],
      "additionalProperties": false,
      "properties": { "id": { "type": "string", "pattern": "^s[1-9][0-9]*$" }, "label": { "type": "string" }, "at": { "$ref": "#/$defs/span" } }
    },
    "signal": {
      "description": "width: the least width the selects imply (a[7:0] -> 8); declared: the width declared in the scope.",
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": { "name": { "type": "string" }, "width": { "type": "integer" }, "declared": { "type": "integer" } }
    },
    "port": {
      "type": "object",
      "required": ["name", "ty", "at"],
      "additionalProperties": false,
      "properties": { "name": { "type": "string" }, "ty": { "type": "string" }, "default": { "$ref": "#/$defs/prop" }, "at": { "$ref": "#/$defs/span" } }
    },
    "seq_decl": {
      "type": "object",
      "required": ["name", "ports", "body", "at"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "scope": { "type": "string" },
        "ports": { "type": "array", "items": { "$ref": "#/$defs/port" } },
        "clock": { "$ref": "#/$defs/clock" },
        "body": { "$ref": "#/$defs/seq" },
        "at": { "$ref": "#/$defs/span" }
      }
    },
    "prop_decl": {
      "type": "object",
      "required": ["name", "ports", "body", "at"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "scope": { "type": "string" },
        "ports": { "type": "array", "items": { "$ref": "#/$defs/port" } },
        "clock": { "$ref": "#/$defs/clock" },
        "disable": { "$ref": "#/$defs/expr" },
        "body": { "$ref": "#/$defs/prop" },
        "at": { "$ref": "#/$defs/span" }
      }
    },
    "scope": {
      "type": "object",
      "required": ["kind", "name", "ports", "params", "at"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["module", "interface", "program", "checker", "package"] },
        "name": { "type": "string" },
        "ports": { "type": "array", "items": { "$ref": "#/$defs/net" } },
        "params": { "type": "array", "items": { "$ref": "#/$defs/param" } },
        "at": { "$ref": "#/$defs/span" }
      }
    },
    "net": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": { "name": { "type": "string" }, "width": { "type": "integer" } }
    },
    "param": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": { "name": { "type": "string" }, "value": { "type": "integer" } }
    },
    "bind": {
      "type": "object",
      "required": ["target", "module", "instance", "ports", "at"],
      "additionalProperties": false,
      "properties": {
        "target": { "type": "string" },
        "instances": { "type": "array", "items": { "type": "string" } },
        "module": { "type": "string" },
        "instance": { "type": "string" },
        "ports": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["expr"],
            "additionalProperties": false,
            "properties": { "name": { "type": "string" }, "expr": { "type": "string" } }
          }
        },
        "at": { "$ref": "#/$defs/span" }
      }
    },
    "bound": {
      "description": "A number, \"$\" (open end), or a constant expression (in declarations, before folding).",
      "oneOf": [{ "type": "integer", "minimum": 0 }, { "const": "$" }, { "$ref": "#/$defs/expr" }]
    },
    "range": {
      "type": "object",
      "required": ["min", "max"],
      "additionalProperties": false,
      "properties": { "min": { "$ref": "#/$defs/bound" }, "max": { "$ref": "#/$defs/bound" } }
    },
    "arg": {
      "description": "An actual argument: positional (no name) or named; no value for an empty one.",
      "type": "object",
      "required": ["value"],
      "additionalProperties": false,
      "properties": { "name": { "type": "string" }, "value": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/prop" }] } }
    },
    "expr": {
      "oneOf": [
        { "type": "object", "required": ["kind", "name", "at"], "additionalProperties": false,
          "properties": { "kind": { "const": "ident" }, "name": { "type": "string" }, "at": { "$ref": "#/$defs/span" } } },
        { "type": "object", "required": ["kind", "name", "value", "at"], "additionalProperties": false,
          "properties": { "kind": { "const": "const" }, "name": { "type": "string" }, "value": { "type": "integer" }, "width": { "type": "integer" }, "at": { "$ref": "#/$defs/span" } } },
        { "type": "object", "required": ["kind", "value", "signed", "base", "text", "at"], "additionalProperties": false,
          "properties": { "kind": { "const": "number" }, "value": { "type": "integer" }, "unknown": { "type": "integer", "description": "the x / z bits" },
                          "width": { "type": "integer" }, "signed": { "type": "boolean" }, "base": { "enum": [2, 8, 10, 16] }, "text": { "type": "string" }, "at": { "$ref": "#/$defs/span" } } },
        { "type": "object", "required": ["kind", "bit", "at"], "additionalProperties": false,
          "properties": { "kind": { "const": "fill" }, "bit": { "enum": ["0", "1", "x", "z"] }, "at": { "$ref": "#/$defs/span" } } },
        { "type": "object", "required": ["kind", "op", "a", "at"], "additionalProperties": false,
          "properties": { "kind": { "const": "unary" }, "op": { "enum": ["!", "~", "&", "|", "^", "~&", "~|", "~^", "-", "+"] }, "a": { "$ref": "#/$defs/expr" }, "at": { "$ref": "#/$defs/span" } } },
        { "type": "object", "required": ["kind", "op", "a", "b", "at"], "additionalProperties": false,
          "properties": { "kind": { "const": "binary" },
                          "op": { "enum": ["**", "*", "/", "%", "+", "-", "<<", ">>", "<<<", ">>>", "<", "<=", ">", ">=", "==", "!=", "===", "!==", "&", "^", "~^", "|", "&&", "||"] },
                          "a": { "$ref": "#/$defs/expr" }, "b": { "$ref": "#/$defs/expr" }, "at": { "$ref": "#/$defs/span" } } },
        { "type": "object", "required": ["kind", "c", "a", "b", "at"], "additionalProperties": false,
          "properties": { "kind": { "const": "cond" }, "c": { "$ref": "#/$defs/expr" }, "a": { "$ref": "#/$defs/expr" }, "b": { "$ref": "#/$defs/expr" }, "at": { "$ref": "#/$defs/span" } } },
        { "type": "object", "required": ["kind", "base", "sel", "index", "at"], "additionalProperties": false,
          "properties": { "kind": { "const": "select" }, "base": { "$ref": "#/$defs/expr" }, "sel": { "enum": ["bit", "part", "up", "down"] },
                          "index": { "$ref": "#/$defs/expr" }, "lsb": { "$ref": "#/$defs/expr" }, "at": { "$ref": "#/$defs/span" } } },
        { "type": "object", "required": ["kind", "items", "at"], "additionalProperties": false,
          "properties": { "kind": { "const": "concat" }, "items": { "type": "array", "items": { "$ref": "#/$defs/expr" } }, "at": { "$ref": "#/$defs/span" } } },
        { "type": "object", "required": ["kind", "count", "items", "at"], "additionalProperties": false,
          "properties": { "kind": { "const": "repl" }, "count": { "$ref": "#/$defs/expr" }, "items": { "type": "array", "items": { "$ref": "#/$defs/expr" } }, "at": { "$ref": "#/$defs/span" } } },
        { "type": "object", "required": ["kind", "a", "set", "at"], "additionalProperties": false,
          "properties": { "kind": { "const": "inside" }, "a": { "$ref": "#/$defs/expr" },
                          "set": { "type": "array", "items": { "oneOf": [
                            { "$ref": "#/$defs/expr" },
                            { "type": "object", "required": ["lo", "hi"], "additionalProperties": false, "properties": { "lo": { "$ref": "#/$defs/expr" }, "hi": { "$ref": "#/$defs/expr" } } } ] } },
                          "at": { "$ref": "#/$defs/span" } } },
        { "type": "object", "required": ["kind", "func", "args", "at"], "additionalProperties": false,
          "properties": { "kind": { "const": "call" },
                          "func": { "enum": ["$rose", "$fell", "$stable", "$changed", "$past", "$onehot", "$onehot0", "$countones", "$isunknown", "$sampled", "$bits", "$clog2"] },
                          "args": { "type": "array", "items": { "$ref": "#/$defs/expr" } }, "at": { "$ref": "#/$defs/span" } } },
        { "type": "object", "required": ["kind", "width", "a", "at"], "additionalProperties": false,
          "properties": { "kind": { "const": "cast" }, "width": { "type": "integer", "minimum": 1 }, "a": { "$ref": "#/$defs/expr" }, "at": { "$ref": "#/$defs/span" } } }
      ]
    },
    "seq": {
      "oneOf": [
        { "type": "object", "required": ["kind", "expr", "at"], "additionalProperties": false,
          "properties": { "kind": { "const": "bool" }, "id": { "type": "string" }, "expr": { "$ref": "#/$defs/expr" }, "at": { "$ref": "#/$defs/span" } } },
        { "type": "object", "required": ["kind", "range", "rhs", "at"], "additionalProperties": false,
          "properties": { "kind": { "const": "delay" }, "lhs": { "$ref": "#/$defs/seq" }, "range": { "$ref": "#/$defs/range" }, "rhs": { "$ref": "#/$defs/seq" }, "at": { "$ref": "#/$defs/span" } } },
        { "type": "object", "required": ["kind", "op", "range", "seq", "at"], "additionalProperties": false,
          "properties": { "kind": { "const": "repeat" }, "op": { "enum": ["[*]", "[->]", "[=]"] }, "range": { "$ref": "#/$defs/range" }, "seq": { "$ref": "#/$defs/seq" }, "at": { "$ref": "#/$defs/span" } } },
        { "type": "object", "required": ["kind", "op", "a", "b", "at"], "additionalProperties": false,
          "properties": { "kind": { "const": "binary" }, "op": { "enum": ["and", "or", "intersect", "within"] }, "a": { "$ref": "#/$defs/seq" }, "b": { "$ref": "#/$defs/seq" }, "at": { "$ref": "#/$defs/span" } } },
        { "type": "object", "required": ["kind", "cond", "seq", "at"], "additionalProperties": false,
          "properties": { "kind": { "const": "throughout" }, "cond": { "$ref": "#/$defs/seq" }, "seq": { "$ref": "#/$defs/seq" }, "at": { "$ref": "#/$defs/span" } } },
        { "type": "object", "required": ["kind", "seq", "at"], "additionalProperties": false,
          "properties": { "kind": { "const": "first_match" }, "seq": { "$ref": "#/$defs/seq" }, "at": { "$ref": "#/$defs/span" } } },
        { "type": "object", "required": ["kind", "name", "args", "at"], "additionalProperties": false,
          "properties": { "kind": { "const": "instance" }, "name": { "type": "string" }, "args": { "type": "array", "items": { "$ref": "#/$defs/arg" } },
                          "body": { "$ref": "#/$defs/seq" }, "at": { "$ref": "#/$defs/span" } } }
      ]
    },
    "prop": {
      "oneOf": [
        { "type": "object", "required": ["kind", "seq"], "additionalProperties": false,
          "properties": { "kind": { "const": "seq" }, "seq": { "$ref": "#/$defs/seq" } } },
        { "type": "object", "required": ["kind", "op", "ante", "cons", "at"], "additionalProperties": false,
          "properties": { "kind": { "const": "implies" }, "op": { "enum": ["|->", "|=>", "#-#", "#=#"] }, "ante": { "$ref": "#/$defs/seq" }, "cons": { "$ref": "#/$defs/prop" }, "at": { "$ref": "#/$defs/span" } } },
        { "type": "object", "required": ["kind", "p", "at"], "additionalProperties": false,
          "properties": { "kind": { "const": "not" }, "p": { "$ref": "#/$defs/prop" }, "at": { "$ref": "#/$defs/span" } } },
        { "type": "object", "required": ["kind", "op", "a", "b", "at"], "additionalProperties": false,
          "properties": { "kind": { "const": "binary" }, "op": { "enum": ["and", "or"] }, "a": { "$ref": "#/$defs/prop" }, "b": { "$ref": "#/$defs/prop" }, "at": { "$ref": "#/$defs/span" } } },
        { "type": "object", "required": ["kind", "cond", "then", "at"], "additionalProperties": false,
          "properties": { "kind": { "const": "if" }, "cond": { "$ref": "#/$defs/expr" }, "then": { "$ref": "#/$defs/prop" }, "else": { "$ref": "#/$defs/prop" }, "at": { "$ref": "#/$defs/span" } } },
        { "type": "object", "required": ["kind", "strong", "n", "p", "at"], "additionalProperties": false,
          "properties": { "kind": { "const": "nexttime" }, "strong": { "type": "boolean" }, "n": { "$ref": "#/$defs/bound" }, "p": { "$ref": "#/$defs/prop" }, "at": { "$ref": "#/$defs/span" } } },
        { "type": "object", "required": ["kind", "strong", "p", "at"], "additionalProperties": false,
          "properties": { "kind": { "const": "always" }, "strong": { "type": "boolean" }, "range": { "$ref": "#/$defs/range" }, "p": { "$ref": "#/$defs/prop" }, "at": { "$ref": "#/$defs/span" } } },
        { "type": "object", "required": ["kind", "strong", "p", "at"], "additionalProperties": false,
          "properties": { "kind": { "const": "eventually" }, "strong": { "type": "boolean" }, "range": { "$ref": "#/$defs/range" }, "p": { "$ref": "#/$defs/prop" }, "at": { "$ref": "#/$defs/span" } } },
        { "type": "object", "required": ["kind", "name", "args", "at"], "additionalProperties": false,
          "properties": { "kind": { "const": "instance" }, "name": { "type": "string" }, "args": { "type": "array", "items": { "$ref": "#/$defs/arg" } },
                          "body": { "$ref": "#/$defs/prop" }, "at": { "$ref": "#/$defs/span" } } }
      ]
    }
  }
}

{
  "name": "wavefw",
  "displayName": "wavefw — waves",
  "description": "VCD and FST dumps in a tab: the wavefw viewer with assertions, bus transactions and the agent's live link; works over Remote-SSH / WSL with nothing installed on the host",
  "publisher": "wavefw",
  "version": "0.0.0",
  "license": "MIT",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Visualization", "Other"],
  "keywords": ["vcd", "fst", "waveform", "wavedrom", "systemverilog", "sva"],
  "extensionKind": ["workspace"],
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": false, "description": "The extension runs the bundled sva program on the dumps of the workspace." },
    "virtualWorkspaces": false
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "wavefw.waves",
        "displayName": "wavefw",
        "selector": [{ "filenamePattern": "*.vcd" }, { "filenamePattern": "*.fst" }],
        "priority": "option"
      }
    ],
    "commands": [
      { "command": "wavefw.open", "title": "Open in wavefw", "category": "wavefw" },
      { "command": "wavefw.reload", "title": "Read the dump again", "category": "wavefw", "icon": "$(refresh)" },
      { "command": "wavefw.live", "title": "Connect to the agent (tools/wavemcp.py)", "category": "wavefw" }
    ],
    "menus": {
      "explorer/context": [
        { "command": "wavefw.open", "when": "resourceExtname =~ /^\\.(vcd|fst)$/i", "group": "navigation@9" }
      ],
      "editor/title": [
        { "command": "wavefw.reload", "when": "activeCustomEditorId == wavefw.waves", "group": "navigation" }
      ],
      "commandPalette": [
        { "command": "wavefw.reload", "when": "activeCustomEditorId == wavefw.waves" },
        { "command": "wavefw.live", "when": "activeCustomEditorId == wavefw.waves" }
      ]
    },
    "configuration": {
      "title": "wavefw",
      "properties": {
        "wavefw.autoReload": {
          "type": "boolean",
          "default": false,
          "description": "When the dump changes on the disk (a new simulation), read it again at once, the view kept. Off: the tab says so and ⟳ reads it."
        },
        "wavefw.live": {
          "type": "boolean",
          "default": true,
          "description": "Connect the open tabs to an agent's tools/wavemcp.py of this user when it starts its live link (view_live), and let it open dumps here."
        },
        "wavefw.sva": {
          "type": "string",
          "default": "",
          "description": "The sva program that turns an FST into VCD text (empty: the one inside the extension)."
        }
      }
    }
  }
}

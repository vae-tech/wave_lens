{
  "name": "wavelens",
  "displayName": "WaveLens — waves",
  "description": "VCD and FST dumps in a tab: the WaveLens viewer with assertions, bus transactions and the agent's live link; works over Remote-SSH / WSL with nothing installed on the host",
  "publisher": "vae-tech",
  "repository": { "type": "git", "url": "https://github.com/vae-tech/wavelens" },
  "version": "0.0.0",
  "license": "MIT",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Visualization", "Other"],
  "keywords": ["vcd", "fst", "waveform", "wavedrom", "systemverilog", "sva"],
  "extensionKind": ["workspace"],
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": false, "description": "The extension runs the bundled sva program on the dumps of the workspace." },
    "virtualWorkspaces": false
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "wavelens.waves",
        "displayName": "WaveLens",
        "selector": [{ "filenamePattern": "*.vcd" }, { "filenamePattern": "*.fst" }],
        "priority": "option"
      }
    ],
    "commands": [
      { "command": "wavelens.open", "title": "Open in WaveLens", "category": "WaveLens" },
      { "command": "wavelens.reload", "title": "Read the dump again", "category": "WaveLens", "icon": "$(refresh)" },
      { "command": "wavelens.live", "title": "Connect to the agent (tools/wavemcp.py)", "category": "WaveLens" }
    ],
    "menus": {
      "explorer/context": [
        { "command": "wavelens.open", "when": "resourceExtname =~ /^\\.(vcd|fst)$/i", "group": "navigation@9" }
      ],
      "editor/title": [
        { "command": "wavelens.reload", "when": "activeCustomEditorId == wavelens.waves", "group": "navigation" }
      ],
      "commandPalette": [
        { "command": "wavelens.reload", "when": "activeCustomEditorId == wavelens.waves" },
        { "command": "wavelens.live", "when": "activeCustomEditorId == wavelens.waves" }
      ]
    },
    "configuration": {
      "title": "WaveLens",
      "properties": {
        "wavelens.autoReload": {
          "type": "boolean",
          "default": false,
          "description": "When the dump changes on the disk (a new simulation), read it again at once, the view kept. Off: the tab says so and ⟳ reads it."
        },
        "wavelens.live": {
          "type": "boolean",
          "default": true,
          "description": "Connect the open tabs to an agent's tools/wavemcp.py of this user when it starts its live link (view_live), and let it open dumps here."
        },
        "wavelens.sva": {
          "type": "string",
          "default": "",
          "description": "The sva program that turns an FST into VCD text (empty: the one inside the extension)."
        }
      }
    }
  }
}

# Editor settings that match the code (docs/SV_STYLE.md for SystemVerilog)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{sv,svh,sva,v}]
indent_size = 4
max_line_length = 100

[*.py]
indent_size = 4

[*.{js,css,html,json}]
indent_size = 2

[*.rs]
indent_size = 4

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
